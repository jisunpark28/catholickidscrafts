{
  "framework": "nextjs",
  "buildCommand": "bash scripts/vercel-build.sh",
  "headers": [
    {
      "source": "/games/tiny-priest/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "catholickidscrafts.com"
        }
      ],
      "destination": "https://www.catholickidscrafts.com/:path*",
      "permanent": true
    }
  ],
  "crons": [
    {
      "path": "/api/cron/weekly-email",
      "schedule": "0 11 * * 5"
    },
    {
      "path": "/api/cron/plus-reminders",
      "schedule": "0 14 * * *"
    }
  ]
}

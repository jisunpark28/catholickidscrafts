{
  "framework": "nextjs",
  "buildCommand": "pnpm run vercel-build",
  "headers": [
    {
      "source": "/games/tiny-priest/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "catholickidscrafts.com"
        }
      ],
      "destination": "https://www.catholickidscrafts.com/:path*",
      "permanent": true
    }
  ]
}

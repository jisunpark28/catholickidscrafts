# Database (SQLite local; use Postgres URL on Vercel — see README)
DATABASE_URL="file:./dev.db"

# Auth.js / NextAuth — generate: openssl rand -base64 32
AUTH_SECRET="replace-with-long-random-string"

# First admin (used only by `pnpm db:seed` to create login)
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="change-me-before-deploy"

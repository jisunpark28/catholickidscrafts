# Copy this file to `.env` in the project root, then fill in real values.
# Required for /curriculum and /resources: DATABASE_URL + DIRECT_URL (Neon Postgres).
# Restart `npm run dev` after editing .env.

# ─── Site (production) ───────────────────────────────────────────
NEXT_PUBLIC_SITE_URL="https://www.catholickidscrafts.com"

# Google Search Console → Ownership verification → HTML tag → copy content="..." value only
GOOGLE_SITE_VERIFICATION=""
# Optional alias (inlined at build time if you prefer): NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=""

# ─── Neon Postgres (free tier) ─────────────────────────────────────
# 1. https://neon.tech → New project → copy connection strings
# 2. Pooled (for Next.js on Vercel):
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require"
# 3. Direct (for prisma migrate — Neon dashboard → Connection details → Direct):
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxx.region.aws.neon.tech/neondb?sslmode=require"

# Local dev: use the same Neon strings (free — no local Postgres install needed)

# ─── Auth (NextAuth) ─────────────────────────────────────────────
# Generate: openssl rand -base64 32
AUTH_SECRET="replace-with-long-random-string"
# Production (Vercel): https://www.catholickidscrafts.com
# Local Google OAuth: set this to http://localhost:3000 (used ahead of NEXT_PUBLIC_SITE_URL in dev)
AUTH_URL="http://localhost:3000"

# First super-admin (only for `pnpm db:seed` — change password after first login)
ADMIN_EMAIL="you@catholickidscrafts.com"
ADMIN_PASSWORD="use-a-strong-password"
ADMIN_NAME="Site Owner"

# ─── Vercel Blob (required on Vercel for admin uploads) ──────────
# Production: Vercel → Storage → Blob → Connect (auto-sets BLOB_READ_WRITE_TOKEN) → redeploy.
# Without this, PDFs / photo booth frames / church images fail with ENOENT on Vercel.
# Local dev: leave empty to save under public/uploads/
BLOB_READ_WRITE_TOKEN=""

# ─── Teachers Pay Teachers (footer + home) ─────────────────────────
# Your TPT store URL (optional; defaults to Catholic Kids Crafts store)
NEXT_PUBLIC_TPT_STORE_URL="https://www.teacherspayteachers.com/store/catholic-kids-crafts"

# Optional: host Tiny Priest elsewhere (defaults to /games/tiny-priest/)
# Leave empty to use /public/games/tiny-priest from this repo. External URLs skip repo updates.
NEXT_PUBLIC_CHURCH_GAME_URL=""

# ─── Family Google sign-in (optional) ───────────────────────────
# Create OAuth client: Web application — see docs/FAMILY_GOOGLE_SIGNIN.md
# Both must be non-empty or the "Continue with Google" button stays hidden (prod).
GOOGLE_CLIENT_ID="your-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="GOCSPX-your-client-secret"

# ─── Legal / contact (privacy page) ─────────────────────────────
NEXT_PUBLIC_CONTACT_EMAIL="privacy@catholickidscrafts.com"

# Republish full Evangelizo reading text on-site (default false — USCCB RSS + links only)
MASS_REPUBLISH_EVANGELIZO="false"

# --- Stripe billing (Plus one-time passes, USD, no auto-renew) ---
# Leave empty to disable billing: /api/billing/* return 503 "Billing not configured".
# Dashboard -> Developers -> API keys (use sk_test_... until launch)
STRIPE_SECRET_KEY=""
# Dashboard -> Developers -> Webhooks -> endpoint https://www.catholickidscrafts.com/api/billing/webhook
# Events: checkout.session.completed, checkout.session.async_payment_succeeded, charge.refunded
STRIPE_WEBHOOK_SECRET=""
# Price id (price_...) for the 1-month pass: US$5.99, one-time (not recurring)
STRIPE_PRICE_MONTH=""
# Price id (price_...) for the 1-year pass: US$29.99, one-time (not recurring)
STRIPE_PRICE_YEAR=""
# Set to 1 after Stripe Tax is set up (registrations added) to collect GST/HST at checkout
STRIPE_AUTOMATIC_TAX="0"
# Optional: comma-separated family emails that get Plus without paying (testing)
PAID_PREVIEW_EMAILS=""

# Weekly sheet email (Resend). The opt-in box stays hidden until the first three are set.
RESEND_API_KEY=""
EMAIL_FROM=""
MAILING_ADDRESS=""
# Optional reply-to address for all outgoing email
EMAIL_REPLY_TO=""
# Vercel Cron bearer secret for /api/cron/weekly-email and /api/cron/plus-reminders
CRON_SECRET=""

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum AdminRole {
  SUPER_ADMIN
  OPERATOR
}

model AdminUser {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String?
  passwordHash String
  role         AdminRole @default(OPERATOR)
  createdAt    DateTime  @default(now())

  moderatedGallerySubmissions CraftGallerySubmission[] @relation("GalleryModerator")
}

model CurriculumTrack {
  id          String   @id @default(cuid())
  slug        String   @unique
  stage       String
  title       String
  description String
  body        String   @default("")
  lessonCount Int      @default(0)
  sortOrder   Int      @default(0)
  published   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  resourceLinks CurriculumTrackResource[]
}

/// Display order for resources on a curriculum track page (resource.grade = track.title).
model CurriculumTrackResource {
  id         String   @id @default(cuid())
  trackId    String
  resourceId String
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  track    CurriculumTrack @relation(fields: [trackId], references: [id], onDelete: Cascade)
  resource Resource        @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  @@unique([trackId, resourceId])
  @@index([trackId, sortOrder])
}

model Resource {
  id                String   @id @default(cuid())
  slug              String   @unique
  title             String
  excerpt           String
  content           String
  contentFormat     String   @default("html")
  grade             String
  topic             String
  liturgicalPeriod  String
  downloadLabel     String?
  downloadUrl       String?
  /// Teachers Pay Teachers product or store URL for the full paid pack.
  tptUrl            String?
  /// When true, on-site content/PDF is a free sample; full pack is on TPT.
  isFreeSample      Boolean  @default(true)
  previewImageUrl   String?
  published         Boolean  @default(true)
  /// Page views for public resource detail pages (used for popularity sort).
  viewCount         Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  trackLinks           CurriculumTrackResource[]
  gallerySubmissions   CraftGallerySubmission[]
}

/// User-submitted craft photo; operator approves before public gallery.
model CraftGallerySubmission {
  id              String    @id @default(cuid())
  imageUrl        String
  authorName      String
  caption         String?
  resourceId      String?
  familyAccountId String?
  isApproved      Boolean   @default(false)
  rejectedAt      DateTime?
  moderatedById   String?
  moderatedAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  resource      Resource?      @relation(fields: [resourceId], references: [id], onDelete: SetNull)
  familyAccount FamilyAccount? @relation(fields: [familyAccountId], references: [id], onDelete: SetNull)
  moderatedBy   AdminUser?     @relation("GalleryModerator", fields: [moderatedById], references: [id], onDelete: SetNull)

  @@index([isApproved, createdAt])
  @@index([resourceId])
  @@index([familyAccountId])
}

model UploadedFile {
  id        String   @id @default(cuid())
  filename  String
  url       String
  mimeType  String?
  sizeBytes Int?
  createdAt DateTime @default(now())
}

/// Daily aggregates for the public site (operators view in /admin).
model TrafficDay {
  date           String @id
  pageViews      Int    @default(0)
  uniqueVisitors Int    @default(0)
}

/// One row per visitor per UTC day (for unique visitor counts).
model TrafficVisitorDay {
  visitorId String
  date      String

  @@id([visitorId, date])
  @@index([date])
}

enum RecommendationKind {
  VIDEO
  BOOK
  TEMPLATE
  AUDIO
  WEBSITE
  OTHER
}

/// How outbound links should be labeled (Amazon Associates vs general).
enum ExternalLinkType {
  STANDARD
  AMAZON_AFFILIATE
}

model Recommendation {
  id          String             @id @default(cuid())
  slug        String             @unique
  title       String
  excerpt     String             @default("")
  description String             @default("")
  kind        RecommendationKind @default(OTHER)
  linkType    ExternalLinkType   @default(STANDARD)
  externalUrl String
  author      String?
  imageUrl    String?
  tags        String             @default("")
  sortOrder   Int                @default(0)
  published   Boolean            @default(true)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  @@index([kind])
  @@index([published])
}

/// Operator-managed cards on the public liturgy grids (/liturgy/[topic]).
model LiturgyCard {
  id        String   @id @default(cuid())
  topic     String
  title     String   @default("")
  href      String
  imageUrl  String   @default("")
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([topic, sortOrder])
}

/// Interactive images inside the Tiny Priest 3D church (/play/church).
model ChurchDecoration {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  description String   @default("")
  imageUrl    String
  posX        Float    @default(0)
  posY        Float    @default(2.2)
  posZ        Float    @default(-6)
  width       Float    @default(1.4)
  height      Float    @default(1.4)
  rotationY   Float    @default(0)
  sortOrder   Int      @default(0)
  published   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([published])
}

/// PNG overlay frames for 4-Cut Photo Booth (/play/photo-booth).
model PhotoBoothFrame {
  id        String             @id @default(cuid())
  slug      String             @unique
  title     String
  imageUrl  String
  layout    PhotoBoothLayout   @default(BOTH)
  sortOrder Int                @default(0)
  published Boolean            @default(true)
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  @@index([published])
}

enum PhotoBoothLayout {
  SINGLE
  STRIP
  BOTH
}

/// Words for the falling-word typing game (/play/typing).
model TypingWord {
  id        String   @id @default(cuid())
  word      String   @unique
  hint      String   @default("")
  sortOrder Int      @default(0)
  published Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([published])
}

/// Operator-editable UI copy (keys like `home.hero.title`, `game.tiny_priest.entry.title`).
model SiteCopy {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String   @db.Text
  group     String
  hint      String?
  format    String   @default("plain")
  published Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([group])
  @@index([published])
}

/// Mass Order step text in Tiny Priest church (/play/church).
model MassOrderStep {
  id        String   @id @default(cuid())
  stepIndex Int      @unique
  part      String
  partEn    String
  title     String
  text      String
  gesture   String   @default("idle")
  published Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([published])
}

/// Words for the hangman game (/play/hangman).
model HangmanWord {
  id        String   @id @default(cuid())
  word      String   @unique
  hint      String   @default("")
  sortOrder Int      @default(0)
  published Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([published])
}

/// Home learn hub section headings (e.g. "Bible Reading").
model HomeSection {
  id        String            @id @default(cuid())
  title     String
  sortOrder Int               @default(0)
  published Boolean           @default(true)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  items     HomeSectionItem[]

  @@index([published, sortOrder])
}

/// Pill buttons under each home section (title + href).
model HomeSectionItem {
  id        String      @id @default(cuid())
  sectionId String
  title     String
  href      String
  sortOrder Int         @default(0)
  published Boolean     @default(true)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  section   HomeSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  @@index([sectionId, sortOrder])
  @@index([published])
}

/// Parent account for Bible sticker progress and sub-profiles.
model FamilyAccount {
  id                 String                 @id @default(cuid())
  email              String                 @unique
  passwordHash       String?
  googleId           String?                @unique
  displayName        String?
  /// Pen name for Bible chapter discussion (fallback: displayName).
  discussionPenName  String?
  /// Bumped by "sign out of all devices"; must match the ckc_family / ckc_reader token.
  sessionVersion     Int                    @default(0)
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt
  subProfiles        SubProfile[]
  progress           BibleChapterProgress[] @relation("OwnerProgress")
  gospelDays         GospelDayProgress[]    @relation("OwnerGospelDays")
  typingDrafts       TypingDraft[]          @relation("OwnerTypingDrafts")
  discussionThreads  BibleChapterThread[]   @relation("OwnerDiscussionThreads")
  discussionComments BibleChapterComment[]  @relation("OwnerDiscussionComments")
  passageMemos       BiblePassageMemo[]     @relation("OwnerPassageMemos")
  gallerySubmissions CraftGallerySubmission[]
  billingCustomer    BillingCustomer?
}

/// Student profile under a teacher account (Access ID login); max per account in access-code config.
model SubProfile {
  id                 String                 @id @default(cuid())
  familyAccountId    String
  displayName        String
  /// Pen name for Bible chapter discussion (fallback: displayName).
  discussionPenName  String?
  accessCodeHash     String
  accessCodeLookup   String                 @unique
  accessCodeLast4    String?
  /// DEPRECATED: no longer written (plaintext Access ID). Nulled by migration; drop later.
  accessCodeDisplay  String?
  active             Boolean                @default(true)
  sortOrder          Int                    @default(0)
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt
  familyAccount      FamilyAccount          @relation(fields: [familyAccountId], references: [id], onDelete: Cascade)
  progress           BibleChapterProgress[] @relation("SubProgress")
  gospelDays         GospelDayProgress[]    @relation("SubGospelDays")
  typingDrafts       TypingDraft[]          @relation("SubTypingDrafts")
  discussionThreads  BibleChapterThread[]   @relation("SubDiscussionThreads")
  discussionComments BibleChapterComment[]  @relation("SubDiscussionComments")
  passageMemos       BiblePassageMemo[]     @relation("SubPassageMemos")

  @@index([familyAccountId, sortOrder])
}

/// Completed Bible chapter (typing) for owner, sub, or guest reader.
model BibleChapterProgress {
  id              String         @id @default(cuid())
  bookSlug        String
  chapter         Int
  completedAt     DateTime       @default(now())
  typingAccuracy  Float?
  guestId         String?
  familyAccountId String?
  subProfileId    String?
  familyAccount   FamilyAccount? @relation("OwnerProgress", fields: [familyAccountId], references: [id], onDelete: Cascade)
  subProfile      SubProfile?    @relation("SubProgress", fields: [subProfileId], references: [id], onDelete: Cascade)

  @@unique([guestId, bookSlug, chapter])
  @@unique([familyAccountId, bookSlug, chapter])
  @@unique([subProfileId, bookSlug, chapter])
  @@index([bookSlug, chapter])
  @@index([guestId])
}

/// Daily Gospel typing completed (one sticker per calendar day per reader).
model GospelDayProgress {
  id              String         @id @default(cuid())
  dateKey         String
  completedAt     DateTime       @default(now())
  typingAccuracy  Float?
  guestId         String?
  familyAccountId String?
  subProfileId    String?
  familyAccount   FamilyAccount? @relation("OwnerGospelDays", fields: [familyAccountId], references: [id], onDelete: Cascade)
  subProfile      SubProfile?    @relation("SubGospelDays", fields: [subProfileId], references: [id], onDelete: Cascade)

  @@unique([guestId, dateKey])
  @@unique([familyAccountId, dateKey])
  @@unique([subProfileId, dateKey])
  @@index([dateKey])
}

/// Saved typing text so readers can pause and continue later (separate from stickers).
model TypingDraft {
  id              String         @id @default(cuid())
  draftKey        String
  typedText       String         @db.Text
  elapsedMs       Int?
  updatedAt       DateTime       @updatedAt
  guestId         String?
  familyAccountId String?
  subProfileId    String?
  familyAccount   FamilyAccount? @relation("OwnerTypingDrafts", fields: [familyAccountId], references: [id], onDelete: Cascade)
  subProfile      SubProfile?    @relation("SubTypingDrafts", fields: [subProfileId], references: [id], onDelete: Cascade)

  @@unique([guestId, draftKey])
  @@unique([familyAccountId, draftKey])
  @@unique([subProfileId, draftKey])
  @@index([draftKey])
}

/// Question or thought on a Bible chapter typing page (signed-in readers).
model BibleChapterThread {
  id              String                @id @default(cuid())
  bookSlug        String
  chapter         Int
  body            String                @db.Text
  isAnonymous     Boolean               @default(false)
  /// Snapshot of pen name when posted (ignored when isAnonymous).
  authorLabel     String
  familyAccountId String?
  subProfileId    String?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  familyAccount   FamilyAccount?        @relation("OwnerDiscussionThreads", fields: [familyAccountId], references: [id], onDelete: Cascade)
  subProfile      SubProfile?           @relation("SubDiscussionThreads", fields: [subProfileId], references: [id], onDelete: Cascade)
  comments        BibleChapterComment[]

  @@index([bookSlug, chapter, createdAt])
  @@index([familyAccountId])
  @@index([subProfileId])
}

/// Reply on a Bible chapter thread.
model BibleChapterComment {
  id              String             @id @default(cuid())
  threadId        String
  body            String             @db.Text
  isAnonymous     Boolean            @default(false)
  authorLabel     String
  familyAccountId String?
  subProfileId    String?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  thread          BibleChapterThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  familyAccount   FamilyAccount?     @relation("OwnerDiscussionComments", fields: [familyAccountId], references: [id], onDelete: Cascade)
  subProfile      SubProfile?        @relation("SubDiscussionComments", fields: [subProfileId], references: [id], onDelete: Cascade)

  @@index([threadId, createdAt])
  @@index([familyAccountId])
  @@index([subProfileId])
}


/// DISCUSSION is reserved (never written by the API).
enum BibleMemoVisibility {
  PRIVATE
  FAMILY
  DISCUSSION
}

/// Memo (private or shared with the family) anchored to a verse range / character range of the reading text (paid feature).
model BiblePassageMemo {
  id              String              @id @default(cuid())
  bookSlug        String
  chapter         Int
  startVerse      Int
  endVerse        Int
  /// Character offsets into the normalized chapter typing text (end exclusive).
  startOffset     Int?
  endOffset       Int?
  quotedText      String              @db.Text
  /// Hash of the normalized chapter text when the memo was saved (detect text changes).
  textVersion     String
  body            String              @db.Text
  /// Highlight color key: yellow | sky | green | pink | purple.
  color           String              @default("yellow")
  visibility      BibleMemoVisibility @default(PRIVATE)
  familyAccountId String?
  subProfileId    String?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  familyAccount   FamilyAccount?      @relation("OwnerPassageMemos", fields: [familyAccountId], references: [id], onDelete: Cascade)
  subProfile      SubProfile?         @relation("SubPassageMemos", fields: [subProfileId], references: [id], onDelete: Cascade)

  @@index([familyAccountId, bookSlug, chapter])
  @@index([subProfileId, bookSlug, chapter])
  @@index([bookSlug, chapter])
  @@index([visibility])
}

/// DB-backed sign-in failure counters (admin, parent Google, child Access ID).
model AuthRateLimit {
  key          String    @id
  failures     Int       @default(0)
  windowStart  DateTime  @default(now())
  blockedUntil DateTime?
  updatedAt    DateTime  @default(now())

  @@index([updatedAt])
}

// ─── Billing (Stripe) ─────────────────────────────────────────────────────────

enum SubscriptionStatus {
  ACTIVE
  TRIALING
  PAST_DUE
  CANCELED
  INCOMPLETE
  INCOMPLETE_EXPIRED
  UNPAID
  PAUSED
}

/// Stripe customer for a parent family account (the billing owner).
model BillingCustomer {
  id               String         @id @default(cuid())
  familyAccountId  String         @unique
  stripeCustomerId String         @unique
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  familyAccount    FamilyAccount  @relation(fields: [familyAccountId], references: [id], onDelete: Cascade)
  subscriptions    Subscription[]
}

/// Mirror of a Stripe subscription, kept up to date by /api/billing/webhook.
model Subscription {
  id                   String             @id @default(cuid())
  billingCustomerId    String
  stripeSubscriptionId String             @unique
  status               SubscriptionStatus
  priceId              String?
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean            @default(false)
  canceledAt           DateTime?
  /// First time the subscription went PAST_DUE in the current dunning cycle (for the 7-day grace).
  pastDueSince         DateTime?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  billingCustomer      BillingCustomer    @relation(fields: [billingCustomerId], references: [id], onDelete: Cascade)

  @@index([billingCustomerId])
}

/// Processed Stripe webhook events (idempotency + audit).
model BillingEvent {
  id            String    @id @default(cuid())
  stripeEventId String    @unique
  type          String
  payload       Json
  processedAt   DateTime?
  error         String?
  createdAt     DateTime  @default(now())

  @@index([type])
}

model WeeklyIssue {
  id         String       @id @default(cuid())
  sundayDate DateTime     @unique @db.Date
  title      String
  season     String       @default("")
  cycle      String       @default("")
  gospelRef  String       @default("")
  color      String       @default("")
  published  Boolean      @default(false)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
  items      WeeklyItem[]

  @@index([published, sundayDate])
}

model WeeklyItem {
  id        String      @id @default(cuid())
  issueId   String
  issue     WeeklyIssue @relation(fields: [issueId], references: [id], onDelete: Cascade)
  title     String
  type      String
  fileUrl   String
  thumbUrl  String      @default("")
  topic     String?
  sortOrder Int         @default(0)
  createdAt DateTime    @default(now())

  @@index([issueId, sortOrder])
  @@index([topic])
}

/// Printable Sunday Gospel sheet (Level 1 / Level 2). Content lives in `levels` (see src/lib/gospel-sheet.ts).
model GospelSheet {
  id             String    @id @default(cuid())
  slug           String    @unique
  sundayDate     DateTime  @unique @db.Date
  liturgicalName String
  gospelRef      String
  usccbUrl       String    @default("")
  color          String    @default("green")
  published      Boolean   @default(false)
  /// Shown on the homepage. If none is featured, the latest published sheet is used.
  featured       Boolean   @default(false)
  levels         Json
  /// Set once the Friday email for this sheet went out.
  emailSentAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([published, sundayDate])
}

/// Weekly sheet email list (double opt-in, CASL). status: pending | confirmed | unsubscribed
model EmailSubscriber {
  id               String    @id @default(cuid())
  email            String    @unique
  status           String    @default("pending")
  confirmToken     String?   @unique
  unsubscribeToken String    @unique
  consentAt        DateTime?
  consentIp        String    @default("")
  source           String    @default("")
  confirmedAt      DateTime?
  unsubscribedAt   DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([status])
}

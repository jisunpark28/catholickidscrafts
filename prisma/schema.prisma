generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum AdminRole {
  SUPER_ADMIN
  OPERATOR
}

model AdminUser {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String?
  passwordHash String
  role         AdminRole @default(OPERATOR)
  createdAt    DateTime  @default(now())
}

model CurriculumTrack {
  id          String   @id @default(cuid())
  slug        String   @unique
  stage       String
  title       String
  description String
  body        String   @default("")
  lessonCount Int      @default(0)
  sortOrder   Int      @default(0)
  published   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  resourceLinks CurriculumTrackResource[]
}

/// Display order for resources on a curriculum track page (resource.grade = track.title).
model CurriculumTrackResource {
  id         String   @id @default(cuid())
  trackId    String
  resourceId String
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  track    CurriculumTrack @relation(fields: [trackId], references: [id], onDelete: Cascade)
  resource Resource        @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  @@unique([trackId, resourceId])
  @@index([trackId, sortOrder])
}

model Resource {
  id                String   @id @default(cuid())
  slug              String   @unique
  title             String
  excerpt           String
  content           String
  contentFormat     String   @default("html")
  grade             String
  topic             String
  liturgicalPeriod  String
  downloadLabel     String?
  downloadUrl       String?
  /// Teachers Pay Teachers product or store URL for the full paid pack.
  tptUrl            String?
  /// When true, on-site content/PDF is a free sample; full pack is on TPT.
  isFreeSample      Boolean  @default(true)
  previewImageUrl   String?
  published         Boolean  @default(true)
  /// Page views for public resource detail pages (used for popularity sort).
  viewCount         Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  trackLinks CurriculumTrackResource[]
}

model UploadedFile {
  id        String   @id @default(cuid())
  filename  String
  url       String
  mimeType  String?
  sizeBytes Int?
  createdAt DateTime @default(now())
}

/// Daily aggregates for the public site (operators view in /admin).
model TrafficDay {
  date           String @id
  pageViews      Int    @default(0)
  uniqueVisitors Int    @default(0)
}

/// One row per visitor per UTC day (for unique visitor counts).
model TrafficVisitorDay {
  visitorId String
  date      String

  @@id([visitorId, date])
  @@index([date])
}

enum RecommendationKind {
  VIDEO
  BOOK
  TEMPLATE
  AUDIO
  WEBSITE
  OTHER
}

/// How outbound links should be labeled (Amazon Associates vs general).
enum ExternalLinkType {
  STANDARD
  AMAZON_AFFILIATE
}

model Recommendation {
  id          String             @id @default(cuid())
  slug        String             @unique
  title       String
  excerpt     String             @default("")
  description String             @default("")
  kind        RecommendationKind @default(OTHER)
  linkType    ExternalLinkType   @default(STANDARD)
  externalUrl String
  author      String?
  imageUrl    String?
  tags        String             @default("")
  sortOrder   Int                @default(0)
  published   Boolean            @default(true)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  @@index([kind])
  @@index([published])
}

/// Interactive images inside the Tiny Priest 3D church (/play/church).
model ChurchDecoration {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  description String   @default("")
  imageUrl    String
  posX        Float    @default(0)
  posY        Float    @default(2.2)
  posZ        Float    @default(-6)
  width       Float    @default(1.4)
  height      Float    @default(1.4)
  rotationY   Float    @default(0)
  sortOrder   Int      @default(0)
  published   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([published])
}

/// PNG overlay frames for 4-Cut Photo Booth (/play/photo-booth).
model PhotoBoothFrame {
  id        String             @id @default(cuid())
  slug      String             @unique
  title     String
  imageUrl  String
  layout    PhotoBoothLayout   @default(BOTH)
  sortOrder Int                @default(0)
  published Boolean            @default(true)
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  @@index([published])
}

enum PhotoBoothLayout {
  SINGLE
  STRIP
  BOTH
}

/// Words for the falling-word typing game (/play/typing).
model TypingWord {
  id        String   @id @default(cuid())
  word      String   @unique
  hint      String   @default("")
  sortOrder Int      @default(0)
  published Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([published])
}

/// Operator-editable UI copy (keys like `home.hero.title`, `game.tiny_priest.entry.title`).
model SiteCopy {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String   @db.Text
  group     String
  hint      String?
  format    String   @default("plain")
  published Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([group])
  @@index([published])
}

/// Mass Order step text in Tiny Priest church (/play/church).
model MassOrderStep {
  id        String   @id @default(cuid())
  stepIndex Int      @unique
  part      String
  partEn    String
  title     String
  text      String
  gesture   String   @default("idle")
  published Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([published])
}

/// Words for the hangman game (/play/hangman).
model HangmanWord {
  id        String   @id @default(cuid())
  word      String   @unique
  hint      String   @default("")
  sortOrder Int      @default(0)
  published Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([published])
}

/// Home learn hub section headings (e.g. "Bible Reading").
model HomeSection {
  id        String            @id @default(cuid())
  title     String
  sortOrder Int               @default(0)
  published Boolean           @default(true)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  items     HomeSectionItem[]

  @@index([published, sortOrder])
}

/// Pill buttons under each home section (title + href).
model HomeSectionItem {
  id        String      @id @default(cuid())
  sectionId String
  title     String
  href      String
  sortOrder Int         @default(0)
  published Boolean     @default(true)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  section   HomeSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  @@index([sectionId, sortOrder])
  @@index([published])
}

/// Parent account for Bible sticker progress and sub-profiles.
model FamilyAccount {
  id                 String                 @id @default(cuid())
  email              String                 @unique
  passwordHash       String?
  googleId           String?                @unique
  displayName        String?
  /// Pen name for Bible chapter discussion (fallback: displayName).
  discussionPenName  String?
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt
  subProfiles        SubProfile[]
  progress           BibleChapterProgress[] @relation("OwnerProgress")
  gospelDays         GospelDayProgress[]    @relation("OwnerGospelDays")
  typingDrafts       TypingDraft[]          @relation("OwnerTypingDrafts")
  discussionThreads  BibleChapterThread[]   @relation("OwnerDiscussionThreads")
  discussionComments BibleChapterComment[]  @relation("OwnerDiscussionComments")
  lessonKits         LessonKit[]
  parishMemberships  ParishMember[]
}

/// Child/class sub-profile (max 30 per family); logs in with Access ID only.
model SubProfile {
  id                 String                 @id @default(cuid())
  familyAccountId    String
  displayName        String
  /// Pen name for Bible chapter discussion (fallback: displayName).
  discussionPenName  String?
  accessCodeHash     String
  accessCodeLookup   String                 @unique
  accessCodeLast4    String?
  /// Full Access ID for parent dashboard (login still uses hash only).
  accessCodeDisplay  String?
  active             Boolean                @default(true)
  sortOrder          Int                    @default(0)
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt
  familyAccount      FamilyAccount          @relation(fields: [familyAccountId], references: [id], onDelete: Cascade)
  progress           BibleChapterProgress[] @relation("SubProgress")
  gospelDays         GospelDayProgress[]    @relation("SubGospelDays")
  typingDrafts       TypingDraft[]          @relation("SubTypingDrafts")
  discussionThreads  BibleChapterThread[]   @relation("SubDiscussionThreads")
  discussionComments BibleChapterComment[]  @relation("SubDiscussionComments")

  @@index([familyAccountId, sortOrder])
}

/// Completed Bible chapter (typing) for owner, sub, or guest reader.
model BibleChapterProgress {
  id              String         @id @default(cuid())
  bookSlug        String
  chapter         Int
  completedAt     DateTime       @default(now())
  typingAccuracy  Float?
  guestId         String?
  familyAccountId String?
  subProfileId    String?
  familyAccount   FamilyAccount? @relation("OwnerProgress", fields: [familyAccountId], references: [id], onDelete: Cascade)
  subProfile      SubProfile?    @relation("SubProgress", fields: [subProfileId], references: [id], onDelete: Cascade)

  @@unique([guestId, bookSlug, chapter])
  @@unique([familyAccountId, bookSlug, chapter])
  @@unique([subProfileId, bookSlug, chapter])
  @@index([bookSlug, chapter])
  @@index([guestId])
}

/// Daily Gospel typing completed (one sticker per calendar day per reader).
model GospelDayProgress {
  id              String         @id @default(cuid())
  dateKey         String
  completedAt     DateTime       @default(now())
  typingAccuracy  Float?
  guestId         String?
  familyAccountId String?
  subProfileId    String?
  familyAccount   FamilyAccount? @relation("OwnerGospelDays", fields: [familyAccountId], references: [id], onDelete: Cascade)
  subProfile      SubProfile?    @relation("SubGospelDays", fields: [subProfileId], references: [id], onDelete: Cascade)

  @@unique([guestId, dateKey])
  @@unique([familyAccountId, dateKey])
  @@unique([subProfileId, dateKey])
  @@index([dateKey])
}

/// Saved typing text so readers can pause and continue later (separate from stickers).
model TypingDraft {
  id              String         @id @default(cuid())
  draftKey        String
  typedText       String         @db.Text
  elapsedMs       Int?
  updatedAt       DateTime       @updatedAt
  guestId         String?
  familyAccountId String?
  subProfileId    String?
  familyAccount   FamilyAccount? @relation("OwnerTypingDrafts", fields: [familyAccountId], references: [id], onDelete: Cascade)
  subProfile      SubProfile?    @relation("SubTypingDrafts", fields: [subProfileId], references: [id], onDelete: Cascade)

  @@unique([guestId, draftKey])
  @@unique([familyAccountId, draftKey])
  @@unique([subProfileId, draftKey])
  @@index([draftKey])
}

/// Question or thought on a Bible chapter typing page (signed-in readers).
model BibleChapterThread {
  id              String                @id @default(cuid())
  bookSlug        String
  chapter         Int
  body            String                @db.Text
  isAnonymous     Boolean               @default(false)
  /// Snapshot of pen name when posted (ignored when isAnonymous).
  authorLabel     String
  familyAccountId String?
  subProfileId    String?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  familyAccount   FamilyAccount?        @relation("OwnerDiscussionThreads", fields: [familyAccountId], references: [id], onDelete: Cascade)
  subProfile      SubProfile?           @relation("SubDiscussionThreads", fields: [subProfileId], references: [id], onDelete: Cascade)
  comments        BibleChapterComment[]

  @@index([bookSlug, chapter, createdAt])
  @@index([familyAccountId])
  @@index([subProfileId])
}

enum LessonKitScope {
  GLOBAL_TEMPLATE
  PERSONAL
  PARISH
}

enum LessonBlockType {
  CUSTOM_NOTE
  RESOURCE
  PLAY_GAME
  TYPING_WORDS
  HANGMAN_WORDS
  GOSPEL_TYPING
  BIBLE_CHAPTER
  MASS_TODAY
}

enum ParishRole {
  DRE
  CATECHIST
}

/// Parish / PSR workspace (Phase 2).
model Parish {
  id         String         @id @default(cuid())
  name       String
  slug       String         @unique
  inviteCode String         @unique
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
  members    ParishMember[]
  lessonKits LessonKit[]
}

model ParishMember {
  id              String     @id @default(cuid())
  parishId        String
  familyAccountId String
  role            ParishRole @default(CATECHIST)
  createdAt       DateTime   @default(now())
  parish          Parish     @relation(fields: [parishId], references: [id], onDelete: Cascade)
  familyAccount   FamilyAccount @relation(fields: [familyAccountId], references: [id], onDelete: Cascade)

  @@unique([parishId, familyAccountId])
  @@index([familyAccountId])
}

/// Assembled lesson (templates + personal copies) for classroom run.
model LessonKit {
  id               String          @id @default(cuid())
  shareSlug        String          @unique
  title            String
  description      String          @default("")
  scope            LessonKitScope  @default(PERSONAL)
  sourceKitId      String?
  familyAccountId  String?
  parishId         String?
  liturgicalPeriod String?
  gradeBand        String?
  /// JSON: { gospelMaxChars?, includedBlockIds? } for /family route
  familyMode       Json?
  published        Boolean         @default(false)
  sortOrder        Int             @default(0)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  blocks           LessonBlock[]
  opens            LessonKitOpen[]
  familyAccount    FamilyAccount?  @relation(fields: [familyAccountId], references: [id], onDelete: Cascade)
  parish           Parish?         @relation(fields: [parishId], references: [id], onDelete: SetNull)

  @@index([scope, published, sortOrder])
  @@index([familyAccountId])
  @@index([parishId])
}

model LessonBlock {
  id        String          @id @default(cuid())
  kitId     String
  sortOrder Int             @default(0)
  type      LessonBlockType
  label     String?
  config    Json            @default("{}")
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  kit       LessonKit       @relation(fields: [kitId], references: [id], onDelete: Cascade)

  @@index([kitId, sortOrder])
}

/// Anonymous daily open counts per kit (DRE dashboard).
model LessonKitOpen {
  id      String    @id @default(cuid())
  kitId   String
  dateKey String
  opens   Int       @default(0)
  kit     LessonKit @relation(fields: [kitId], references: [id], onDelete: Cascade)

  @@unique([kitId, dateKey])
  @@index([dateKey])
}

/// Reply on a Bible chapter thread.
model BibleChapterComment {
  id              String             @id @default(cuid())
  threadId        String
  body            String             @db.Text
  isAnonymous     Boolean            @default(false)
  authorLabel     String
  familyAccountId String?
  subProfileId    String?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  thread          BibleChapterThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  familyAccount   FamilyAccount?     @relation("OwnerDiscussionComments", fields: [familyAccountId], references: [id], onDelete: Cascade)
  subProfile      SubProfile?        @relation("SubDiscussionComments", fields: [subProfileId], references: [id], onDelete: Cascade)

  @@index([threadId, createdAt])
  @@index([familyAccountId])
  @@index([subProfileId])
}


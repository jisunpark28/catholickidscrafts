generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum AdminRole {
  SUPER_ADMIN
  OPERATOR
}

model AdminUser {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String?
  passwordHash String
  role         AdminRole @default(OPERATOR)
  createdAt    DateTime  @default(now())
}

model CurriculumTrack {
  id          String   @id @default(cuid())
  slug        String   @unique
  stage       String
  title       String
  description String
  body        String   @default("")
  lessonCount Int      @default(0)
  sortOrder   Int      @default(0)
  published   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Resource {
  id                String   @id @default(cuid())
  slug              String   @unique
  title             String
  excerpt           String
  content           String
  contentFormat     String   @default("html")
  grade             String
  topic             String
  liturgicalPeriod  String
  downloadLabel     String?
  downloadUrl       String?
  /// Teachers Pay Teachers product or store URL for the full paid pack.
  tptUrl            String?
  /// When true, on-site content/PDF is a free sample; full pack is on TPT.
  isFreeSample      Boolean  @default(true)
  previewImageUrl   String?
  published         Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model UploadedFile {
  id        String   @id @default(cuid())
  filename  String
  url       String
  mimeType  String?
  sizeBytes Int?
  createdAt DateTime @default(now())
}

/// Daily aggregates for the public site (operators view in /admin).
model TrafficDay {
  date           String @id
  pageViews      Int    @default(0)
  uniqueVisitors Int    @default(0)
}

/// One row per visitor per UTC day (for unique visitor counts).
model TrafficVisitorDay {
  visitorId String
  date      String

  @@id([visitorId, date])
  @@index([date])
}

enum RecommendationKind {
  VIDEO
  BOOK
  TEMPLATE
  AUDIO
  WEBSITE
  OTHER
}

/// How outbound links should be labeled (Amazon Associates vs general).
enum ExternalLinkType {
  STANDARD
  AMAZON_AFFILIATE
}

model Recommendation {
  id          String             @id @default(cuid())
  slug        String             @unique
  title       String
  excerpt     String             @default("")
  description String             @default("")
  kind        RecommendationKind @default(OTHER)
  linkType    ExternalLinkType   @default(STANDARD)
  externalUrl String
  author      String?
  imageUrl    String?
  tags        String             @default("")
  sortOrder   Int                @default(0)
  published   Boolean            @default(true)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  @@index([kind])
  @@index([published])
}

/// Interactive images inside the Tiny Priest 3D church (/play/church).
model ChurchDecoration {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  description String   @default("")
  imageUrl    String
  posX        Float    @default(0)
  posY        Float    @default(2.2)
  posZ        Float    @default(-6)
  width       Float    @default(1.4)
  height      Float    @default(1.4)
  rotationY   Float    @default(0)
  sortOrder   Int      @default(0)
  published   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([published])
}

/// PNG overlay frames for 4-Cut Photo Booth (/play/photo-booth).
model PhotoBoothFrame {
  id        String             @id @default(cuid())
  slug      String             @unique
  title     String
  imageUrl  String
  layout    PhotoBoothLayout   @default(BOTH)
  sortOrder Int                @default(0)
  published Boolean            @default(true)
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  @@index([published])
}

enum PhotoBoothLayout {
  SINGLE
  STRIP
  BOTH
}

/// Words for the falling-word typing game (/play/typing).
model TypingWord {
  id        String   @id @default(cuid())
  word      String   @unique
  hint      String   @default("")
  sortOrder Int      @default(0)
  published Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([published])
}

/// Operator-editable UI copy (keys like `home.hero.title`, `game.tiny_priest.entry.title`).
model SiteCopy {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String   @db.Text
  group     String
  hint      String?
  format    String   @default("plain")
  published Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([group])
  @@index([published])
}

/// Mass Order step text in Tiny Priest church (/play/church).
model MassOrderStep {
  id        String   @id @default(cuid())
  stepIndex Int      @unique
  part      String
  partEn    String
  title     String
  text      String
  gesture   String   @default("idle")
  published Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([published])
}

/// Words for the hangman game (/play/hangman).
model HangmanWord {
  id        String   @id @default(cuid())
  word      String   @unique
  hint      String   @default("")
  sortOrder Int      @default(0)
  published Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([published])
}


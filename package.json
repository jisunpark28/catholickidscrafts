{
  "name": "catholickidscrafts",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "predev": "prisma generate",
    "dev": "next dev",
    "prebuild": "node -e \"JSON.parse(require('fs').readFileSync('package.json','utf8'))\"",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "db:migrate": "prisma migrate dev",
    "db:migrate-deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "postinstall": "prisma generate",
    "vercel-build": "bash scripts/vercel-build.sh",
    "db:seed-typing": "tsx prisma/seed-typing-words.ts",
    "db:seed-hangman": "tsx prisma/seed-hangman-words.ts",
    "db:seed-mass-order": "tsx prisma/seed-mass-order-steps.ts",
    "db:seed-site-copy": "tsx prisma/seed-site-copy.ts",
    "db:seed-home-sections": "tsx prisma/seed-home-sections.ts",
    "db:seed-production-once": "prisma generate && tsx scripts/prod-seed-once.ts",
    "db:seed-trinity-resource": "tsx prisma/seed-holy-trinity-resource.ts",
    "vestments:split": "node scripts/split-vestment-spritesheet.mjs",
    "vestments:optimize": "node scripts/optimize-vestment-pngs.mjs",
    "generate:favicons": "python3 scripts/generate-favicons.py",
    "favicon:generate": "python3 scripts/generate-favicon-ico.py"
  },
  "dependencies": {
    "@neondatabase/serverless": "^0.10.4",
    "@prisma/client": "5.22.0",
    "@tiptap/extension-link": "^3.24.0",
    "@tiptap/extension-placeholder": "^3.24.0",
    "@tiptap/extension-underline": "^3.24.0",
    "@tiptap/pm": "^3.24.0",
    "@tiptap/react": "^3.24.0",
    "@tiptap/starter-kit": "^3.24.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/blob": "^2.4.0",
    "bcryptjs": "^3.0.3",
    "gray-matter": "^4.0.3",
    "isomorphic-dompurify": "^3.15.0",
    "jose": "^6.2.3",
    "next": "^15.5.7",
    "next-auth": "5.0.0-beta.29",
    "prisma": "5.22.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "sanitize-html": "^2.17.4",
    "sharp": "^0.34.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@tailwindcss/postcss": "^4.1.8",
    "@types/node": "^22.15.21",
    "@types/react": "^19.1.4",
    "@types/react-dom": "^19.1.5",
    "@types/sanitize-html": "^2.16.1",
    "dotenv": "^17.4.2",
    "eslint": "^9.27.0",
    "eslint-config-next": "^15.5.7",
    "tailwindcss": "^4.1.8",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
